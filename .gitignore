# Entorno virtual de Python
.venv/
venv/
env/

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local de SQLite (este proyecto usa MySQL)
*.sqlite3
db.sqlite3

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Archivos estáticos y multimedia generados
staticfiles/
media/

# Registros y archivos temporales
*.log
*.tmp
*.bak

# Configuración del editor
.vscode/
.idea/
*.swp

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini
